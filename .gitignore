# Dependencies and build output (Vercel installs and builds on its own)
node_modules/
dist/

# Generated by `tsc -b` from vite.config.ts
vite.config.js
vite.config.d.ts
*.tsbuildinfo

# Local working material: references, installers, drafts
References/

# Agent skills: installed locally (see skills-lock.json); .claude/skills holds absolute symlinks to .agents
.agents/
.claude/skills/
.claude/settings.local.json

# Vercel CLI link and local env
.vercel/
.env
.env.*

# Logs and OS files
*.log
.DS_Store
Thumbs.db
desktop.ini
